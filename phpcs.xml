<?xml version="1.0"?>
<ruleset name="Hashy Stock Sync">
	<description>WordPress-Extra for the plugin source. Mirrors the 2026-09-06 review ruleset (wp_plugins/REVIEW/tooling/phpcs.xml). Run "phpcs" from the plugin root; "phpcbf" applies the fixable part.</description>

	<file>.</file>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Build output and dependencies. -->
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<!-- Third-party libraries keep their own style (SimpleXLSX, SimpleXLSXGen, plugin-update-checker). -->
	<exclude-pattern>*/includes/lib/*</exclude-pattern>
	<!-- Not shipped: the release script and the command-line tests. -->
	<exclude-pattern>*/scripts/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<rule ref="WordPress-Extra"/>

	<!-- The migration shim is a one-file plugin; its main file must keep the old slug's name. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/shim/wc-stock-sync/wc-stock-sync.php</exclude-pattern>
	</rule>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="hashy-stock-sync"/>
			</property>
		</properties>
	</rule>

	<!-- WooCommerce's capability, used on every admin action in this plugin. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
